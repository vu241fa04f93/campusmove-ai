{
  "name": "campusmove-ai",
  "version": "0.1.0",
  "description": "Intelligent Student Transport & Route Agent - Campus Mobility Platform",
  "private": true,
  "scripts": {
    "install:all": "npm install && npm --prefix server install && npm --prefix client install",
    "seed": "npm --prefix server run seed",
    "server": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"cyan,magenta\" \"npm run server\" \"npm run client\"",
    "build": "npm --prefix client run build"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "keywords": [
    "campus-transport",
    "bus-tracking",
    "student-mobility",
    "ai-agent",
    "react",
    "leaflet",
    "express"
  ],
  "author": "CampusMove AI Team",
  "license": "MIT"
}
